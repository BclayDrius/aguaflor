---
import { BRAND } from '../data/products';

interface Props {
  kicker?: string;
  label: string;
  message: string;
  variant?: 'surface' | 'underwater';
}

const {
  kicker,
  label,
  message,
  variant = 'underwater',
} = Astro.props;

const href = `https://wa.me/${BRAND.whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<div class={`wa-cta-banner wa-cta-banner--${variant} js-wa-cta`}>
  {kicker && <p class="wa-cta-kicker">{kicker}</p>}
  <a href={href} target="_blank" rel="noopener" class="pill wa-cta-btn" data-magnetic>
    <span class="wa-pulse-dot" aria-hidden="true"></span>
    <svg class="wa-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm5.76 14.07c-.24.68-1.41 1.3-1.95 1.38-.5.07-1.13.1-1.82-.12-.42-.13-.96-.31-1.65-.61-2.91-1.26-4.81-4.18-4.96-4.38-.15-.2-1.18-1.57-1.18-3s.75-2.12 1.02-2.41c.27-.29.59-.36.79-.36.2 0 .39 0 .56.01.18.01.42-.07.66.51.24.59.83 2.02.9 2.17.07.15.12.32.02.52-.1.2-.15.32-.29.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.36 1.46.3.15.47.12.64-.07.17-.2.74-.86.94-1.16.2-.29.39-.25.66-.15.27.1 1.72.81 2.01.96.3.15.49.22.56.34.07.12.07.7-.17 1.38Z" />
    </svg>
    <span>{label}</span>
  </a>
</div>
