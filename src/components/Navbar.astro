---
import { Image } from 'astro:assets';
import logoSmall from '../assets/images/logo.jpeg';
---

<header class="site-nav" id="site-nav">
  <div class="nav-inner">
    <a href="#inicio" class="nav-brand" aria-label="Aguaflor inicio">
      <span class="nav-logo-wrap">
        <Image src={logoSmall} alt="Logo Aguaflor" width={100} height={100} class="nav-logo-img" />
      </span>
      <span class="nav-wordmark">Aguaflor</span>
    </a>

    <nav class="nav-links" aria-label="Navegación principal">
      <a href="#inicio" class="nav-link">Inicio</a>
      <a href="#productos" class="nav-link">Presentaciones</a>
      <a href="#nosotros" class="nav-link">Pureza</a>
      <a href="#contacto" class="nav-cta pill" data-magnetic>Pedir ahora</a>
    </nav>

    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <a href="#inicio" class="mobile-drawer-link">Inicio</a>
  <a href="#productos" class="mobile-drawer-link">Presentaciones</a>
  <a href="#nosotros" class="mobile-drawer-link">Nuestra Pureza</a>
  <a href="#contacto" class="mobile-drawer-link">Contacto</a>
  <a href="https://wa.me/51995822660" target="_blank" rel="noopener" class="mobile-drawer-cta">
    Pedir por WhatsApp · +51 995 822 660
  </a>
</div>
